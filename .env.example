# Configuração do Ambiente MCP Corel (Exemplo)
# ATENÇÃO: NUNCA coloque tokens reais ou dados sensíveis neste arquivo de exemplo.
# Copie este arquivo para .env no seu ambiente local Windows antes de rodar o sistema.

# Modo de Operação do MCP (stdio padrão para clientes locais)
MCP_TRANSPORT=stdio
MCP_LOG_LEVEL=INFO

# Configurações do CorelDRAW
# Caminho de instalação (a ser validado pelo comando de diagnóstico na máquina Windows)
COREL_INSTALL_PATH=C:\Program Files\Corel\CorelDRAW Graphics Suite 2023\Programs64\CorelDRW.exe
COREL_PROGID=CorelDRAW.Application.24
COREL_COM_TIMEOUT_SECONDS=60
COREL_VISIBLE=true

# Diretórios de Trabalho Locais (Caminhos Absolutos no Windows)
WORK_DIR=C:\mcp-corel\data
ARTIFACTS_DIR=C:\mcp-corel\data\artifacts
PREVIEWS_DIR=C:\mcp-corel\data\previews
JOBS_DB_PATH=C:\mcp-corel\data\jobs\jobs.sqlite3

# Configurações do Bot do Telegram (Opcional - Operação Remota Segura)
# O bot opera exclusivamente por Long Polling de saída (sem portas abertas de entrada)
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=INSIRA_SEU_TOKEN_AQUI_DO_BOTFATHER
# Lista de IDs numéricos autorizados separados por vírgula (Ex: 12345678,98765432)
TELEGRAM_ALLOWED_USER_IDS=000000000
TELEGRAM_POLL_TIMEOUT=30
TELEGRAM_RATE_LIMIT_PER_MINUTE=20

# Segurança e Restrições de Disco
# Diretório raiz seguro fora do qual nenhuma escrita ou leitura é permitida (previne path traversal)
SAFE_STORAGE_ROOT=C:\mcp-corel\data
ALLOW_OVERWRITE_WITHOUT_CONFIRMATION=false
MAX_IMPORT_FILE_SIZE_MB=50
MAX_EXPORT_FILE_SIZE_MB=100
